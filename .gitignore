# Virtual environments
venv/
.venv/

# Data files (too large for GitHub)
*.csv
*.ckpt
*.npy

# Allow result metric CSVs (small outputs, important for reproducibility)
!ecl_main_experiment/results/**/*.csv
!ecl_weather_covariates_experiment/outputs/raw_metrics/*.csv

# Python cache
__pycache__/
*.pyc
*.pyo

# Mac system files
.DS_Store

# Jupyter checkpoints
.ipynb_checkpoints/

# Git embedded repos
ecl_main_experiment/models/itransformer/iTransformer/
ecl_weather_covariates_experiment/outputs/.matplotlib/

# Private local notes (not for GitHub)
private_notes/
